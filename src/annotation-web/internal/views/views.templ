package views

import (
	"fmt"

	"github.com/PhysShell/relationship_fix/src/annotation-web/internal/model"
)

templ layout(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<main class="shell">
				{ children... }
			</main>
		</body>
	</html>
}

templ LanguagePage() {
	@layout("Relationship Fix annotation") {
		<section class="card">
			<p class="eyebrow">Relationship Fix</p>
			<h1>Язык предъявления / Presentation language</h1>
			<p>Выберите язык интерфейса и текста эпизодов. / Choose the interface and episode presentation language.</p>
			<form method="post" action="/language" class="stack">
				<button type="submit" name="language" value="ru" class="choice">Русский</button>
				<button type="submit" name="language" value="en" class="choice">English</button>
			</form>
		</section>
	}
}

templ IntroPage(language model.Language) {
	@layout(text(language, "Инструкция", "Instructions")) {
		<section class="card prose">
			<p class="eyebrow">Relationship Fix · no-JS dogfood</p>
			<h1>{ text(language, "Исследование разметки диалогов", "Dialogue annotation study") }</h1>
			<p>{ text(language,
				"Мы проверяем, насколько одинаково разные люди применяют одни и те же операциональные категории к фрагментам диалога. Здесь не оцениваются вы или ваши отношения.",
				"We are testing how consistently different people apply the same operational categories to dialogue excerpts. We are not evaluating you or your relationship.") }</p>
			<p><strong>{ text(language, "Главное правило:", "Main rule:") }</strong> { text(language,
				"размечайте только то, что наблюдаемо в предоставленном фрагменте. Не угадывайте мотив, характер или намерение человека.",
				"annotate only what is observable in the provided excerpt. Do not infer a person's motive, character, or intention.") }</p>
			<h2>{ text(language, "Категории", "Categories") }</h2>
			<ul>
				<li><strong>B.BLAME_CRITICISM</strong> — { text(language, "обвинение / критика", "blame / criticism") }</li>
				<li><strong>B.PRESSURE_FOR_CHANGE</strong> — { text(language, "давление с целью изменения", "pressure for change") }</li>
				<li><strong>B.VALIDATION</strong> — { text(language, "признание / понимание переживания или позиции", "validation / substantive acknowledgement") }</li>
				<li><strong>B.REPAIR_ATTEMPT</strong> — { text(language, "попытка снизить накал / восстановить взаимодействие", "repair attempt / de-escalation") }</li>
				<li><strong>B.AVOIDANCE_TOPIC_SHIFT</strong> — { text(language, "уход / смена поднятой темы", "avoidance / topic shift") }</li>
			</ul>
			<p><strong>none_observed</strong> — { text(language,
				"контекста достаточно и ни одна категория не наблюдается.",
				"the excerpt provides enough context and no category is observed.") }</p>
			<p><strong>abstained</strong> — { text(language,
				"недостающий контекст действительно мешает решить, есть категория или нет.",
				"missing context genuinely prevents deciding whether a category is present.") }</p>
			<form method="get" action="/item/0">
				<button type="submit" class="primary">{ text(language, "Начать", "Start") }</button>
			</form>
		</section>
	}
}

templ ItemPage(language model.Language, item model.Item, index int, total int, step string, labels []model.Label, selected []string, originalRevealed bool, errorMessage string) {
	@layout(fmt.Sprintf("%s %d/%d", text(language, "Пример", "Example"), index+1, total)) {
		<section class="card">
			<header class="item-header">
				<p class="eyebrow">{ fmt.Sprintf("%d / %d", index+1, total) }</p>
				<h1>{ text(language, "Пример", "Example") } { fmt.Sprintf("%d", index+1) }</h1>
			</header>
			@episode(language, item, originalRevealed)
			if errorMessage != "" {
				<p class="error">{ errorMessage }</p>
			}
			if step == "decision" {
				@decisionForm(language, index)
			} else if step == "labels" {
				@labelsForm(language, index, labels, selected)
			} else if step == "evidence" {
				@evidenceForm(language, index, labels, selected)
			} else if step == "abstain" {
				@abstainForm(language, index)
			}
		</section>
	}
}

templ episode(language model.Language, item model.Item, originalRevealed bool) {
	<div class="episode">
		<p class="source-note">{ text(language, "Источник", "Source") }: <strong>{ string(item.SourceLanguage) }</strong></p>
		<div class="bubble context"><strong>A</strong><br/>{ item.Presentation[language].Context }</div>
		<div class="bubble target"><strong>{ text(language, "Размечаемое сообщение", "Target message") } · B</strong><br/>{ item.Presentation[language].Target }</div>
		if item.SourceLanguage != language {
			if originalRevealed {
				<details open class="original">
					<summary>{ text(language, "Оригинал", "Original") }</summary>
					@sourceMessages(item.Source)
				</details>
			} else {
				<form method="post" action={ templ.URL(fmt.Sprintf("/item/%s/original", item.ID)) }>
					<button type="submit" class="secondary">{ text(language, "Показать оригинал", "Show original") }</button>
				</form>
			}
		}
	</div>
}

templ sourceMessages(messages []model.Message) {
	<div class="source-messages">
		for _, message := range messages {
			<p><strong>{ message.Author }</strong>: { message.Text }</p>
		}
	</div>
}

templ decisionForm(language model.Language, index int) {
	<form method="post" action={ templ.URL(fmt.Sprintf("/item/%d/decision", index)) } class="stack">
		<fieldset>
			<legend>{ text(language, "Решение", "Decision") }</legend>
			<label class="radio"><input type="radio" name="decision" value="assigned" required/> <span><strong>assigned</strong> — { text(language, "наблюдается одна или несколько категорий", "one or more categories are observed") }</span></label>
			<label class="radio"><input type="radio" name="decision" value="none_observed" required/> <span><strong>none_observed</strong> — { text(language, "фрагмента достаточно; категории не наблюдаются", "enough context; no category is observed") }</span></label>
			<label class="radio"><input type="radio" name="decision" value="abstained" required/> <span><strong>abstained</strong> — { text(language, "недостающий контекст мешает решить", "missing context prevents a decision") }</span></label>
		</fieldset>
		<button class="primary" type="submit">{ text(language, "Продолжить", "Continue") }</button>
	</form>
}

templ labelsForm(language model.Language, index int, labels []model.Label, selected []string) {
	<form method="post" action={ templ.URL(fmt.Sprintf("/item/%d/labels", index)) } class="stack">
		<fieldset>
			<legend>{ text(language, "Категории", "Categories") }</legend>
			for _, label := range labels {
				<label class="check"><input type="checkbox" name="labels" value={ label.ID }/> <span><strong>{ label.ID }</strong><br/>{ label.DisplayName[language] }</span></label>
			}
		</fieldset>
		<button class="primary" type="submit">{ text(language, "Продолжить", "Continue") }</button>
	</form>
}

templ evidenceForm(language model.Language, index int, labels []model.Label, selected []string) {
	<form method="post" action={ templ.URL(fmt.Sprintf("/item/%d/evidence", index)) } class="stack">
		<h2>{ text(language, "Цитаты-доказательства", "Evidence quotes") }</h2>
		<p>{ text(language,
			"Для каждой выбранной категории укажите самый короткий непрерывный фрагмент размечаемого сообщения.",
			"For every selected category, enter the shortest continuous exact span from the target message.") }</p>
		for _, labelID := range selected {
			<label class="field"><span>{ labelID }</span><input type="text" name={ "evidence_" + labelID } required/></label>
		}
		<button class="primary" type="submit">{ text(language, "Сохранить и дальше", "Save and continue") }</button>
	</form>
}

templ abstainForm(language model.Language, index int) {
	<form method="post" action={ templ.URL(fmt.Sprintf("/item/%d/abstain", index)) } class="stack">
		<label class="field">
			<span>{ text(language, "Причина", "Reason") }</span>
			<select name="reason" required>
				<option value="">—</option>
				<option value="insufficient_context">insufficient_context</option>
				<option value="ambiguous_between_labels">ambiguous_between_labels</option>
				<option value="unit_not_applicable">unit_not_applicable</option>
				<option value="source_corrupted">source_corrupted</option>
				<option value="language_unsupported">language_unsupported</option>
				<option value="other">other</option>
			</select>
		</label>
		<button class="primary" type="submit">{ text(language, "Сохранить и дальше", "Save and continue") }</button>
	</form>
}

templ DonePage(language model.Language) {
	@layout(text(language, "Готово", "Done")) {
		<section class="card prose">
			<p class="eyebrow">Relationship Fix · dogfood</p>
			<h1>{ text(language, "Готово", "Done") }</h1>
			<p>{ text(language,
				"Ответы сохранены только в памяти этого dogfood-сервера. Скачайте JSON до перезапуска сервера.",
				"Answers are stored only in this dogfood server's memory. Download the JSON before restarting the server.") }</p>
			<p><a class="primary link-button" href="/submission.json">{ text(language, "Скачать submission.json", "Download submission.json") }</a></p>
		</section>
	}
}

func text(language model.Language, ru string, en string) string {
	if language == model.LanguageEN {
		return en
	}
	return ru
}
