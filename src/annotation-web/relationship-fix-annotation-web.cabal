cabal-version:      3.0
name:               relationship-fix-annotation-web
version:            0.1.0.0
build-type:         Simple
license:            MIT
extra-source-files:
  test/fixtures/hs-v1-legacy.sql

common common-options
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Domain
    Catalog
    Feedback
    Schema
    Server
  build-depends:
    base >=4.20 && <4.21,
    aeson >=2.2 && <2.3,
    directory >=1.3 && <1.4,
    migrant-core >=0.1.1.1 && <0.1.2,
    migrant-sqlite-simple >=0.1.1.1 && <0.1.2,
    monad-logger >=0.3 && <0.4,
    persistent >=2.17 && <2.19,
    persistent-sqlite >=2.13 && <2.14,
    sqlite-simple >=0.4.18 && <0.5,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15,
    yesod >=1.6.2 && <1.7

executable annotation-web
  import: common-options
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base >=4.20 && <4.21,
    relationship-fix-annotation-web,
    text >=2.1 && <2.2,
    warp >=3.3 && <3.5,
    yesod >=1.6.2 && <1.7

-- Schema writes live here and nowhere else. Deployment runs this before it
-- starts the server; the server itself only reads the schema and refuses to
-- serve a database it does not recognise.
executable annotation-web-migrate
  import: common-options
  hs-source-dirs: migrate
  main-is: Main.hs
  build-depends:
    base >=4.20 && <4.21,
    relationship-fix-annotation-web,
    migrant-core >=0.1.1.1 && <0.1.2,
    text >=2.1 && <2.2

test-suite annotation-web-test
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    MigrationSpec
  build-depends:
    base >=4.20 && <4.21,
    relationship-fix-annotation-web,
    aeson >=2.2 && <2.3,
    bytestring >=0.11 && <0.13,
    directory >=1.3 && <1.4,
    direct-sqlite >=2.3 && <2.4,
    filepath >=1.4 && <1.6,
    hspec >=2.11 && <2.12,
    migrant-core >=0.1.1.1 && <0.1.2,
    persistent >=2.17 && <2.19,
    sqlite-simple >=0.4.18 && <0.5,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.2,
    wai-extra >=3.1 && <3.2,
    yesod >=1.6.2 && <1.7,
    yesod-test >=1.6 && <1.7
