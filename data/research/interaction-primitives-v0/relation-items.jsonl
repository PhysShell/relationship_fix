{"schema_version": "rf.primitives-item.v1", "item_id": "rp-01", "language": "ru", "stratum": "easy_positive", "anchor_kind": "negative", "messages": [{"message_id": "rp-01-m1", "author": "a", "text": "Ты опять не предупредил, что задержишься.", "timestamp": 1700000000}, {"message_id": "rp-01-m2", "author": "b", "text": "Да, я виноват, забыл написать.", "timestamp": 1700000120}], "anchor_message_id": "rp-01-m1", "target_message_id": "rp-01-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-02", "language": "ru", "stratum": "easy_positive", "anchor_kind": "negative", "messages": [{"message_id": "rp-02-m1", "author": "a", "text": "Меня бесит, что посуда третий день стоит.", "timestamp": 1700003600}, {"message_id": "rp-02-m2", "author": "b", "text": "Меня тоже бесит, но у меня был завал.", "timestamp": 1700003720}], "anchor_message_id": "rp-02-m1", "target_message_id": "rp-02-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-03", "language": "ru", "stratum": "easy_positive", "anchor_kind": "softening", "messages": [{"message_id": "rp-03-m1", "author": "a", "text": "Прости, я вчера сорвался.", "timestamp": 1700007200}, {"message_id": "rp-03-m2", "author": "b", "text": "Спасибо, что сказал. Мне правда было неприятно.", "timestamp": 1700007320}], "anchor_message_id": "rp-03-m1", "target_message_id": "rp-03-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-04", "language": "en", "stratum": "easy_positive", "anchor_kind": "softening", "messages": [{"message_id": "rp-04-m1", "author": "a", "text": "I'm sorry, that came out harsher than I meant.", "timestamp": 1700010800}, {"message_id": "rp-04-m2", "author": "b", "text": "Thanks. I appreciate you saying that.", "timestamp": 1700010920}], "anchor_message_id": "rp-04-m1", "target_message_id": "rp-04-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-05", "language": "ru", "stratum": "easy_positive", "anchor_kind": "neutral", "messages": [{"message_id": "rp-05-m1", "author": "a", "text": "Во сколько завтра выезжаем?", "timestamp": 1700014400}, {"message_id": "rp-05-m2", "author": "b", "text": "Думаю, часов в восемь.", "timestamp": 1700014520}], "anchor_message_id": "rp-05-m1", "target_message_id": "rp-05-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-06", "language": "ru", "stratum": "easy_negative", "anchor_kind": "negative", "messages": [{"message_id": "rp-06-m1", "author": "a", "text": "Ты вообще меня не слушаешь.", "timestamp": 1700018000}, {"message_id": "rp-06-m2", "author": "b", "text": "Напомни, у нас молоко есть?", "timestamp": 1700018120}], "anchor_message_id": "rp-06-m1", "target_message_id": "rp-06-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-07", "language": "ru", "stratum": "easy_negative", "anchor_kind": "neutral", "messages": [{"message_id": "rp-07-m1", "author": "a", "text": "Завтра приедет мастер по стиралке.", "timestamp": 1700021600}, {"message_id": "rp-07-m2", "author": "b", "text": "Кстати, я забыл сказать — Лёша женится.", "timestamp": 1700021720}], "anchor_message_id": "rp-07-m1", "target_message_id": "rp-07-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-08", "language": "en", "stratum": "easy_negative", "anchor_kind": "neutral", "messages": [{"message_id": "rp-08-m1", "author": "a", "text": "The landlord replied about the lease.", "timestamp": 1700025200}, {"message_id": "rp-08-m2", "author": "b", "text": "Did you see the football score last night?", "timestamp": 1700025320}], "anchor_message_id": "rp-08-m1", "target_message_id": "rp-08-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-09", "language": "ru", "stratum": "easy_negative", "anchor_kind": "negative", "messages": [{"message_id": "rp-09-m1", "author": "a", "text": "Ты опять всё решил без меня.", "timestamp": 1700028800}, {"message_id": "rp-09-m2", "author": "b", "text": "Смотри какой закат из окна.", "timestamp": 1700028920}], "anchor_message_id": "rp-09-m1", "target_message_id": "rp-09-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-10", "language": "ru", "stratum": "easy_negative", "anchor_kind": "neutral", "messages": [{"message_id": "rp-10-m1", "author": "a", "text": "Я записалась к врачу на четверг.", "timestamp": 1700032400}, {"message_id": "rp-10-m2", "author": "b", "text": "У нас кончился корм для кота.", "timestamp": 1700032520}], "anchor_message_id": "rp-10-m1", "target_message_id": "rp-10-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-11", "language": "ru", "stratum": "adjacency_trap", "anchor_kind": "negative", "messages": [{"message_id": "rp-11-m1", "author": "a", "text": "Мы так и не обсудили деньги.", "timestamp": 1700036000}, {"message_id": "rp-11-m2", "author": "b", "text": "Ааа, я забыл мусор вынести, сейчас.", "timestamp": 1700036120}], "anchor_message_id": "rp-11-m1", "target_message_id": "rp-11-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-12", "language": "ru", "stratum": "adjacency_trap", "anchor_kind": "negative", "messages": [{"message_id": "rp-12-m1", "author": "a", "text": "Ты вечно переносишь этот разговор.", "timestamp": 1700039600}, {"message_id": "rp-12-m2", "author": "b", "text": "Блин, телефон садится.", "timestamp": 1700039720}], "anchor_message_id": "rp-12-m1", "target_message_id": "rp-12-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-13", "language": "en", "stratum": "adjacency_trap", "anchor_kind": "negative", "messages": [{"message_id": "rp-13-m1", "author": "a", "text": "You keep putting this off.", "timestamp": 1700043200}, {"message_id": "rp-13-m2", "author": "b", "text": "Ugh, my train is delayed again.", "timestamp": 1700043320}], "anchor_message_id": "rp-13-m1", "target_message_id": "rp-13-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-14", "language": "ru", "stratum": "adjacency_trap", "anchor_kind": "softening", "messages": [{"message_id": "rp-14-m1", "author": "a", "text": "Извини, я был неправ вчера.", "timestamp": 1700046800}, {"message_id": "rp-14-m2", "author": "b", "text": "Так, я в магазине, что брать кроме хлеба?", "timestamp": 1700046920}], "anchor_message_id": "rp-14-m1", "target_message_id": "rp-14-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-15", "language": "ru", "stratum": "adjacency_trap", "anchor_kind": "neutral", "messages": [{"message_id": "rp-15-m1", "author": "a", "text": "Я оплатила интернет.", "timestamp": 1700050400}, {"message_id": "rp-15-m2", "author": "b", "text": "Мам звонила, просила перезвонить.", "timestamp": 1700050520}], "anchor_message_id": "rp-15-m1", "target_message_id": "rp-15-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-16", "language": "ru", "stratum": "explicit_reply_trap", "anchor_kind": "negative", "messages": [{"message_id": "rp-16-m1", "author": "a", "text": "Ты снова не позвонил, когда обещал.", "timestamp": 1700054000}, {"message_id": "rp-16-m2", "author": "a", "text": "И ещё карту не вернул.", "timestamp": 1700054120}, {"message_id": "rp-16-m3", "author": "b", "text": "Карта в куртке, забыл.", "timestamp": 1700054240, "reply_to": "rp-16-m2"}], "anchor_message_id": "rp-16-m1", "target_message_id": "rp-16-m3", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-17", "language": "ru", "stratum": "explicit_reply_trap", "anchor_kind": "negative", "messages": [{"message_id": "rp-17-m1", "author": "a", "text": "Мне обидно, что ты так сказал при твоей маме.", "timestamp": 1700057600}, {"message_id": "rp-17-m2", "author": "a", "text": "И вообще давай в субботу к моим съездим.", "timestamp": 1700057720}, {"message_id": "rp-17-m3", "author": "b", "text": "В субботу не получится, я на смене.", "timestamp": 1700057840, "reply_to": "rp-17-m2"}], "anchor_message_id": "rp-17-m1", "target_message_id": "rp-17-m3", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-18", "language": "en", "stratum": "explicit_reply_trap", "anchor_kind": "softening", "messages": [{"message_id": "rp-18-m1", "author": "a", "text": "Sorry about yesterday, I was out of line.", "timestamp": 1700061200}, {"message_id": "rp-18-m2", "author": "a", "text": "Also, are we still on for Friday?", "timestamp": 1700061320}, {"message_id": "rp-18-m3", "author": "b", "text": "Friday works for me.", "timestamp": 1700061440, "reply_to": "rp-18-m2"}], "anchor_message_id": "rp-18-m1", "target_message_id": "rp-18-m3", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-19", "language": "ru", "stratum": "explicit_reply_trap", "anchor_kind": "softening", "messages": [{"message_id": "rp-19-m1", "author": "a", "text": "Прости за резкость, я перегнула.", "timestamp": 1700064800}, {"message_id": "rp-19-m2", "author": "a", "text": "И скинь, пожалуйста, адрес кафе.", "timestamp": 1700064920}, {"message_id": "rp-19-m3", "author": "b", "text": "Держи адрес.", "timestamp": 1700065040, "reply_to": "rp-19-m2"}], "anchor_message_id": "rp-19-m1", "target_message_id": "rp-19-m3", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-20", "language": "ru", "stratum": "explicit_reply_trap", "anchor_kind": "neutral", "messages": [{"message_id": "rp-20-m1", "author": "a", "text": "Я отправила документы.", "timestamp": 1700068400}, {"message_id": "rp-20-m2", "author": "a", "text": "Ещё нужен твой ИНН.", "timestamp": 1700068520}, {"message_id": "rp-20-m3", "author": "b", "text": "Сейчас пришлю ИНН.", "timestamp": 1700068640, "reply_to": "rp-20-m2"}], "anchor_message_id": "rp-20-m1", "target_message_id": "rp-20-m3", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-21", "language": "ru", "stratum": "intervening_neutral_turn", "anchor_kind": "negative", "messages": [{"message_id": "rp-21-m1", "author": "a", "text": "Ты опять не предупредил.", "timestamp": 1700072000}, {"message_id": "rp-21-m2", "author": "b", "text": "угу", "timestamp": 1700072120}, {"message_id": "rp-21-m3", "author": "b", "text": "Кстати, смотри какой кот во дворе.", "timestamp": 1700072240}], "anchor_message_id": "rp-21-m1", "target_message_id": "rp-21-m3", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-22", "language": "ru", "stratum": "intervening_neutral_turn", "anchor_kind": "negative", "messages": [{"message_id": "rp-22-m1", "author": "a", "text": "Меня задело, как ты ответил при гостях.", "timestamp": 1700075600}, {"message_id": "rp-22-m2", "author": "b", "text": "ок", "timestamp": 1700075720}, {"message_id": "rp-22-m3", "author": "b", "text": "Ты не помнишь, где зарядка?", "timestamp": 1700075840}], "anchor_message_id": "rp-22-m1", "target_message_id": "rp-22-m3", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-23", "language": "en", "stratum": "intervening_neutral_turn", "anchor_kind": "negative", "messages": [{"message_id": "rp-23-m1", "author": "a", "text": "You brushed me off in front of your friends.", "timestamp": 1700079200}, {"message_id": "rp-23-m2", "author": "b", "text": "k", "timestamp": 1700079320}, {"message_id": "rp-23-m3", "author": "b", "text": "Have you seen my keys?", "timestamp": 1700079440}], "anchor_message_id": "rp-23-m1", "target_message_id": "rp-23-m3", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-24", "language": "ru", "stratum": "intervening_neutral_turn", "anchor_kind": "softening", "messages": [{"message_id": "rp-24-m1", "author": "a", "text": "Прости, я вчера наговорил лишнего.", "timestamp": 1700082800}, {"message_id": "rp-24-m2", "author": "b", "text": "мм", "timestamp": 1700082920}, {"message_id": "rp-24-m3", "author": "b", "text": "Ладно, я понял тебя. Проехали, правда.", "timestamp": 1700083040}], "anchor_message_id": "rp-24-m1", "target_message_id": "rp-24-m3", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-25", "language": "ru", "stratum": "intervening_neutral_turn", "anchor_kind": "neutral", "messages": [{"message_id": "rp-25-m1", "author": "a", "text": "Я забронировала столик на семь.", "timestamp": 1700086400}, {"message_id": "rp-25-m2", "author": "b", "text": "ага", "timestamp": 1700086520}, {"message_id": "rp-25-m3", "author": "b", "text": "А парковка там есть?", "timestamp": 1700086640}], "anchor_message_id": "rp-25-m1", "target_message_id": "rp-25-m3", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-26", "language": "ru", "stratum": "multi_topic", "anchor_kind": "softening", "messages": [{"message_id": "rp-26-m1", "author": "a", "text": "Прости, что не пришёл. Понимаю, что подвёл.", "timestamp": 1700090000}, {"message_id": "rp-26-m2", "author": "b", "text": "Ладно, принимаю. И давай тогда решим, что с воскресеньем.", "timestamp": 1700090120}], "anchor_message_id": "rp-26-m1", "target_message_id": "rp-26-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-27", "language": "ru", "stratum": "multi_topic", "anchor_kind": "negative", "messages": [{"message_id": "rp-27-m1", "author": "a", "text": "Мне было обидно, что ты не пришёл.", "timestamp": 1700093600}, {"message_id": "rp-27-m2", "author": "b", "text": "Понимаю. И хочу объяснить, почему вчера всё сорвалось с работой.", "timestamp": 1700093720}], "anchor_message_id": "rp-27-m1", "target_message_id": "rp-27-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-28", "language": "en", "stratum": "multi_topic", "anchor_kind": "neutral", "messages": [{"message_id": "rp-28-m1", "author": "a", "text": "Can we sort out the holiday dates?", "timestamp": 1700097200}, {"message_id": "rp-28-m2", "author": "b", "text": "Yes, let's do it tonight. Also my sister is visiting next week.", "timestamp": 1700097320}], "anchor_message_id": "rp-28-m1", "target_message_id": "rp-28-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-29", "language": "ru", "stratum": "multi_topic", "anchor_kind": "softening", "messages": [{"message_id": "rp-29-m1", "author": "a", "text": "Извини за вчера, я была на нервах.", "timestamp": 1700100800}, {"message_id": "rp-29-m2", "author": "b", "text": "Да я понял. Слушай, а с ремонтом мы что решаем?", "timestamp": 1700100920}], "anchor_message_id": "rp-29-m1", "target_message_id": "rp-29-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-30", "language": "ru", "stratum": "multi_topic", "anchor_kind": "neutral", "messages": [{"message_id": "rp-30-m1", "author": "a", "text": "Надо продлить страховку.", "timestamp": 1700104400}, {"message_id": "rp-30-m2", "author": "b", "text": "Продлю на неделе. И надо ещё записаться на ТО.", "timestamp": 1700104520}], "anchor_message_id": "rp-30-m1", "target_message_id": "rp-30-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-31", "language": "ru", "stratum": "multi_target", "anchor_kind": "negative", "messages": [{"message_id": "rp-31-m1", "author": "a", "text": "Ты не забрал посылку.", "timestamp": 1700108000}, {"message_id": "rp-31-m2", "author": "a", "text": "И на звонки не отвечал весь день.", "timestamp": 1700108120}, {"message_id": "rp-31-m3", "author": "b", "text": "Да, и то и другое на мне. Виноват.", "timestamp": 1700108240}], "anchor_message_id": "rp-31-m1", "target_message_id": "rp-31-m3", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-32", "language": "ru", "stratum": "multi_target", "anchor_kind": "negative", "messages": [{"message_id": "rp-32-m1", "author": "a", "text": "Опять опоздал.", "timestamp": 1700111600}, {"message_id": "rp-32-m2", "author": "a", "text": "И даже не написал.", "timestamp": 1700111720}, {"message_id": "rp-32-m3", "author": "b", "text": "Понимаю, что раздражает и то, и то.", "timestamp": 1700111840}], "anchor_message_id": "rp-32-m1", "target_message_id": "rp-32-m3", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-33", "language": "en", "stratum": "multi_target", "anchor_kind": "neutral", "messages": [{"message_id": "rp-33-m1", "author": "a", "text": "Did you book the hotel?", "timestamp": 1700115200}, {"message_id": "rp-33-m2", "author": "a", "text": "And did you check the train times?", "timestamp": 1700115320}, {"message_id": "rp-33-m3", "author": "b", "text": "Both done this morning.", "timestamp": 1700115440}], "anchor_message_id": "rp-33-m1", "target_message_id": "rp-33-m3", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-34", "language": "ru", "stratum": "multi_target", "anchor_kind": "neutral", "messages": [{"message_id": "rp-34-m1", "author": "a", "text": "Купишь хлеб?", "timestamp": 1700118800}, {"message_id": "rp-34-m2", "author": "a", "text": "И воды захвати.", "timestamp": 1700118920}, {"message_id": "rp-34-m3", "author": "b", "text": "Ок, всё возьму.", "timestamp": 1700119040}], "anchor_message_id": "rp-34-m1", "target_message_id": "rp-34-m3", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-35", "language": "ru", "stratum": "multi_target", "anchor_kind": "neutral", "messages": [{"message_id": "rp-35-m1", "author": "a", "text": "Я оплатил садик.", "timestamp": 1700122400}, {"message_id": "rp-35-m2", "author": "a", "text": "И записал Мишу к стоматологу.", "timestamp": 1700122520}, {"message_id": "rp-35-m3", "author": "b", "text": "Спасибо, это две вещи с меня сняло.", "timestamp": 1700122640}], "anchor_message_id": "rp-35-m1", "target_message_id": "rp-35-m3", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-36", "language": "ru", "stratum": "negative_not_escalating", "anchor_kind": "negative", "messages": [{"message_id": "rp-36-m1", "author": "a", "text": "Ты всё испортила своим звонком.", "timestamp": 1700126000}, {"message_id": "rp-36-m2", "author": "b", "text": "Мне тоже было неприятно, как ты себя повёл.", "timestamp": 1700126120}], "anchor_message_id": "rp-36-m1", "target_message_id": "rp-36-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-37", "language": "ru", "stratum": "negative_not_escalating", "anchor_kind": "negative", "messages": [{"message_id": "rp-37-m1", "author": "a", "text": "Ты меня подставил перед всеми.", "timestamp": 1700129600}, {"message_id": "rp-37-m2", "author": "b", "text": "Я расстроен не меньше, если честно.", "timestamp": 1700129720}], "anchor_message_id": "rp-37-m1", "target_message_id": "rp-37-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-38", "language": "en", "stratum": "negative_not_escalating", "anchor_kind": "negative", "messages": [{"message_id": "rp-38-m1", "author": "a", "text": "You made that whole evening miserable.", "timestamp": 1700133200}, {"message_id": "rp-38-m2", "author": "b", "text": "I wasn't having a great time either.", "timestamp": 1700133320}], "anchor_message_id": "rp-38-m1", "target_message_id": "rp-38-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-39", "language": "ru", "stratum": "negative_not_escalating", "anchor_kind": "negative", "messages": [{"message_id": "rp-39-m1", "author": "a", "text": "Ты вечно всё забываешь.", "timestamp": 1700136800}, {"message_id": "rp-39-m2", "author": "b", "text": "Ну да, забыл. Мне самому противно.", "timestamp": 1700136920}], "anchor_message_id": "rp-39-m1", "target_message_id": "rp-39-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-40", "language": "ru", "stratum": "negative_not_escalating", "anchor_kind": "negative", "messages": [{"message_id": "rp-40-m1", "author": "a", "text": "С тобой невозможно договориться.", "timestamp": 1700140400}, {"message_id": "rp-40-m2", "author": "b", "text": "Мне кажется, мы оба сейчас не в том состоянии.", "timestamp": 1700140520}], "anchor_message_id": "rp-40-m1", "target_message_id": "rp-40-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-41", "language": "ru", "stratum": "softening_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-41-m1", "author": "a", "text": "Прости. Я правда перегнул палку.", "timestamp": 1700144000}, {"message_id": "rp-41-m2", "author": "b", "text": "Принимаю. Мне важно, что ты это сказал.", "timestamp": 1700144120}], "anchor_message_id": "rp-41-m1", "target_message_id": "rp-41-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-42", "language": "ru", "stratum": "softening_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-42-m1", "author": "a", "text": "Я был неправ, и мне жаль.", "timestamp": 1700147600}, {"message_id": "rp-42-m2", "author": "b", "text": "Спасибо. Давай тогда спокойно обсудим.", "timestamp": 1700147720}], "anchor_message_id": "rp-42-m1", "target_message_id": "rp-42-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-43", "language": "en", "stratum": "softening_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-43-m1", "author": "a", "text": "That was my fault, I'm sorry.", "timestamp": 1700151200}, {"message_id": "rp-43-m2", "author": "b", "text": "I hear you. Let's start over.", "timestamp": 1700151320}], "anchor_message_id": "rp-43-m1", "target_message_id": "rp-43-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-44", "language": "ru", "stratum": "softening_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-44-m1", "author": "a", "text": "Понимаю, почему тебе было обидно.", "timestamp": 1700154800}, {"message_id": "rp-44-m2", "author": "b", "text": "Да, именно это меня и задело. Спасибо.", "timestamp": 1700154920}], "anchor_message_id": "rp-44-m1", "target_message_id": "rp-44-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-45", "language": "ru", "stratum": "softening_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-45-m1", "author": "a", "text": "Давай я возьму часть на себя, это честно.", "timestamp": 1700158400}, {"message_id": "rp-45-m2", "author": "b", "text": "Согласна, так будет справедливо.", "timestamp": 1700158520}], "anchor_message_id": "rp-45-m1", "target_message_id": "rp-45-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-46", "language": "ru", "stratum": "softening_non_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-46-m1", "author": "a", "text": "Прости, я был резок.", "timestamp": 1700162000}, {"message_id": "rp-46-m2", "author": "b", "text": "Ладно, пошли ужинать.", "timestamp": 1700162120}], "anchor_message_id": "rp-46-m1", "target_message_id": "rp-46-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-47", "language": "ru", "stratum": "softening_non_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-47-m1", "author": "a", "text": "Я признаю, что тут моя вина.", "timestamp": 1700165600}, {"message_id": "rp-47-m2", "author": "b", "text": "Угу. Ты не забыл про завтра?", "timestamp": 1700165720}], "anchor_message_id": "rp-47-m1", "target_message_id": "rp-47-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-48", "language": "en", "stratum": "softening_non_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-48-m1", "author": "a", "text": "I know I handled that badly, sorry.", "timestamp": 1700169200}, {"message_id": "rp-48-m2", "author": "b", "text": "Right. Anyway, what time is dinner?", "timestamp": 1700169320}], "anchor_message_id": "rp-48-m1", "target_message_id": "rp-48-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-49", "language": "ru", "stratum": "softening_non_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-49-m1", "author": "a", "text": "Извини, пожалуйста.", "timestamp": 1700172800}, {"message_id": "rp-49-m2", "author": "b", "text": "Ну и ты меня извини, конечно, только это ты всё начала.", "timestamp": 1700172920}], "anchor_message_id": "rp-49-m1", "target_message_id": "rp-49-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-50", "language": "ru", "stratum": "softening_non_uptake", "anchor_kind": "softening", "messages": [{"message_id": "rp-50-m1", "author": "a", "text": "Мне жаль, что так вышло.", "timestamp": 1700176400}, {"message_id": "rp-50-m2", "author": "b", "text": "Окей.", "timestamp": 1700176520}], "anchor_message_id": "rp-50-m1", "target_message_id": "rp-50-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-51", "language": "ru", "stratum": "minimal_acknowledgement", "anchor_kind": "negative", "messages": [{"message_id": "rp-51-m1", "author": "a", "text": "Ты опять решил всё сам, не спросив меня.", "timestamp": 1700180000}, {"message_id": "rp-51-m2", "author": "b", "text": "ок", "timestamp": 1700180120}], "anchor_message_id": "rp-51-m1", "target_message_id": "rp-51-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-52", "language": "ru", "stratum": "minimal_acknowledgement", "anchor_kind": "negative", "messages": [{"message_id": "rp-52-m1", "author": "a", "text": "Мне неприятно, что ты так ответил при всех.", "timestamp": 1700183600}, {"message_id": "rp-52-m2", "author": "b", "text": "угу", "timestamp": 1700183720}], "anchor_message_id": "rp-52-m1", "target_message_id": "rp-52-m2", "applicable_primitives": ["P1", "P2", "P3"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-53", "language": "ru", "stratum": "minimal_acknowledgement", "anchor_kind": "softening", "messages": [{"message_id": "rp-53-m1", "author": "a", "text": "Прости, я был неправ.", "timestamp": 1700187200}, {"message_id": "rp-53-m2", "author": "b", "text": "ясно", "timestamp": 1700187320}], "anchor_message_id": "rp-53-m1", "target_message_id": "rp-53-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-54", "language": "en", "stratum": "minimal_acknowledgement", "anchor_kind": "softening", "messages": [{"message_id": "rp-54-m1", "author": "a", "text": "I'm sorry, I should have told you.", "timestamp": 1700190800}, {"message_id": "rp-54-m2", "author": "b", "text": "👍", "timestamp": 1700190920}], "anchor_message_id": "rp-54-m1", "target_message_id": "rp-54-m2", "applicable_primitives": ["P1", "P2", "P4"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-55", "language": "ru", "stratum": "minimal_acknowledgement", "anchor_kind": "neutral", "messages": [{"message_id": "rp-55-m1", "author": "a", "text": "Я перенесла встречу на четверг.", "timestamp": 1700194400}, {"message_id": "rp-55-m2", "author": "b", "text": "понял", "timestamp": 1700194520}], "anchor_message_id": "rp-55-m1", "target_message_id": "rp-55-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-56", "language": "ru", "stratum": "insufficient_context", "anchor_kind": "neutral", "messages": [{"message_id": "rp-56-m1", "author": "a", "text": "Ну?", "timestamp": 1700198000}, {"message_id": "rp-56-m2", "author": "b", "text": "Да.", "timestamp": 1700198120}], "anchor_message_id": "rp-56-m1", "target_message_id": "rp-56-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-57", "language": "ru", "stratum": "insufficient_context", "anchor_kind": "neutral", "messages": [{"message_id": "rp-57-m1", "author": "a", "text": "И что теперь?", "timestamp": 1700201600}, {"message_id": "rp-57-m2", "author": "b", "text": "Не знаю.", "timestamp": 1700201720}], "anchor_message_id": "rp-57-m1", "target_message_id": "rp-57-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-58", "language": "en", "stratum": "insufficient_context", "anchor_kind": "neutral", "messages": [{"message_id": "rp-58-m1", "author": "a", "text": "So?", "timestamp": 1700205200}, {"message_id": "rp-58-m2", "author": "b", "text": "Yeah.", "timestamp": 1700205320}], "anchor_message_id": "rp-58-m1", "target_message_id": "rp-58-m2", "applicable_primitives": ["P1", "P2"]}
{"schema_version": "rf.primitives-item.v1", "item_id": "rp-59", "language": "ru", "stratum": "insufficient_context", "anchor_kind": "negative", "messages": [{"message_id": "rp-59-m1", "author": "a", "text": "Опять двадцать пять.", "timestamp": 1700208800}, {"message_id": "rp-59-m2", "author": "b", "text": "Ага.", "timestamp": 1700208920}], "anchor_message_id": "rp-59-m1", "target_message_id": "rp-59-m2", "applicable_primitives": ["P1", "P2", "P3"]}
