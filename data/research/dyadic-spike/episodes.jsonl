{"schema_version": "rf.dyadic-spike-case.v0", "case_id": "esc-01", "designed_for": "escalation", "actors": ["a", "b"], "silence_after": null, "messages": [{"message_id": "m1", "author": "a", "text": "Ты опять не закрыл счета за месяц.", "timestamp": 1700000000}, {"message_id": "m2", "author": "b", "text": "Я работал. У тебя вечно претензии.", "timestamp": 1700000060}, {"message_id": "m3", "author": "a", "text": "С тобой всегда так, на тебя нельзя положиться.", "timestamp": 1700000120}], "observations": [{"observation_id": "o1", "label": "PRESSURE_FOR_CHANGE", "actor": "a", "message_id": "m1", "quotes": ["не закрыл счета"]}, {"observation_id": "o2", "label": "BLAME_CRITICISM", "actor": "b", "message_id": "m2", "quotes": ["У тебя вечно претензии"]}, {"observation_id": "o3", "label": "BLAME_CRITICISM", "actor": "a", "message_id": "m3", "quotes": ["С тобой всегда так"]}]}
{"schema_version": "rf.dyadic-spike-case.v0", "case_id": "esc-02", "designed_for": "escalation", "actors": ["a", "b"], "silence_after": null, "messages": [{"message_id": "m1", "author": "a", "text": "Мы это уже обсуждали и ничего не поменялось.", "timestamp": 1700086400}, {"message_id": "m2", "author": "b", "text": "Потому что ты неспособна услышать ответ.", "timestamp": 1700086460}, {"message_id": "m3", "author": "a", "text": "Это ты не слышишь. Никогда.", "timestamp": 1700086520}], "observations": [{"observation_id": "o1", "label": "PRESSURE_FOR_CHANGE", "actor": "a", "message_id": "m1", "quotes": ["уже обсуждали"]}, {"observation_id": "o2", "label": "BLAME_CRITICISM", "actor": "b", "message_id": "m2", "quotes": ["ты неспособна услышать"]}, {"observation_id": "o3", "label": "BLAME_CRITICISM", "actor": "a", "message_id": "m3", "quotes": ["Никогда"]}]}
